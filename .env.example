# Copy to .dev.vars (wrangler / workerd reads it in `bun run dev`).
#   cp .env.example .dev.vars
# Production: `wrangler secret put <NAME>` for each secret below.

NODE_ENV="development"

# Nicrron model gateway (OpenAI-compatible). Keys look like sk-af-...
NICRRON_API_KEY=""
NICRRON_BASE_URL="https://api.nicrron.ai/v1"
# Routing preset (nicrron/auto | fastest | cheapest | reasoning | coding) or a concrete model.
NICRRON_MODEL="nicrron/auto"

# BusyQ agent: model for tool-calling runs, and the default lookup version.
AGENT_MODEL="anthropic/claude-sonnet-5-5"
# Nicrron `models` fallback array (comma list, in order), tried when AGENT_MODEL
# is rate-limited (429), down (5xx) or unknown. Each must support tool calling.
AGENT_FALLBACK_MODELS="openai/gpt-6-sol,anthropic/claude-haiku-5-5"
AGENT_VERSION="v1"

# Contracts: the model that reads contracts, and comma-separated fallbacks
# Nicrron tries in order if it errors or is rate-limited.
CONTRACT_MODEL="anthropic/claude-sonnet-5-5"
CONTRACT_FALLBACK_MODELS="openai/gpt-5.4-mini,anthropic/claude-haiku-5-5"
# AI import of vendor invoices (/import), through Nicrron's `models` fallback
# list: the primary first, then the models it cascades to on failure.
IMPORT_MODEL="anthropic/claude-sonnet-5-5"
IMPORT_FALLBACK_MODELS="openai/gpt-5.4,anthropic/claude-haiku-5-5"
# PDFs go only to models that read OpenAI `file` parts through Nicrron
# (Anthropic models silently ignore them).
IMPORT_PDF_MODELS="openai/gpt-5.4,openai/gpt-5.4-mini"

# Projections digest (/projections "Write summary"): the model that narrates
# the forecast numbers, and the Nicrron `models` fallbacks (comma list, in order).
DIGEST_MODEL="anthropic/claude-sonnet-5-5"
DIGEST_FALLBACK_MODELS="openai/gpt-5.4-mini,anthropic/claude-haiku-5-5"
# AI import of the business's own paper documents (/import-document): quotes,
# invoices, receipts… become editable drafts. Same `models` fallback rules,
# and PDFs again only go to models that read OpenAI `file` parts.
DOC_IMPORT_MODEL="anthropic/claude-sonnet-5-5"
DOC_IMPORT_FALLBACK_MODELS="openai/gpt-5.4,anthropic/claude-haiku-5-5"
DOC_IMPORT_PDF_MODELS="openai/gpt-5.4,openai/gpt-5.4-mini"

# PRISM tracing. Tracing is skipped when the key is unset.
PRISMTRACE_API_KEY=""
PRISMTRACE_PROJECT_ID=""
PRISMTRACE_HOST="https://api.prism.blockconvey.com"
