# Copy to .dev.vars (wrangler / workerd reads it in `bun run dev`).
#   cp .env.example .dev.vars
# Production: `wrangler secret put <NAME>` for each secret below.

NODE_ENV="development"

# Nicrron model gateway (OpenAI-compatible). Keys look like sk-af-...
NICRRON_API_KEY=""
NICRRON_BASE_URL="https://api.nicrron.ai/v1"
# Routing preset (nicrron/auto | fastest | cheapest | reasoning | coding) or a concrete model.
NICRRON_MODEL="nicrron/auto"

# BusyQ agent: model for tool-calling runs, and the default lookup version.
AGENT_MODEL="anthropic/claude-sonnet-5-5"
# Nicrron `models` fallback array (comma list, in order), tried when AGENT_MODEL
# is rate-limited (429), down (5xx) or unknown. Each must support tool calling.
AGENT_FALLBACK_MODELS="openai/gpt-6-sol,anthropic/claude-haiku-5-5"
AGENT_VERSION="v1"

# PRISM tracing. Tracing is skipped when the key is unset.
PRISMTRACE_API_KEY=""
PRISMTRACE_PROJECT_ID=""
PRISMTRACE_HOST="https://api.prism.blockconvey.com"
