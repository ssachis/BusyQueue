{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "m-talks2",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	"main": "@tanstack/react-start/server-entry",
	"observability": { "enabled": true },
	// D1 (SQLite). Migrations are generated by drizzle-kit into drizzle/ and
	// applied by wrangler: `bun run db:migrate:local` / `db:migrate:remote`.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "busyq",
			"database_id": "252f3761-882d-4ad4-bbab-241eca94108a",
			"migrations_dir": "drizzle"
		}
	],
	// Private bucket for uploaded documents (AI import). `bun run dev`
	// simulates it locally; run `wrangler r2 bucket create busyq-uploads`
	// once before the first deploy.
	"r2_buckets": [{ "binding": "UPLOADS", "bucket_name": "busyq-uploads" }]
	// Add other bindings (queues, ...) here, then run
	// `bun run cf-typegen` to regenerate worker-configuration.d.ts.
	// Secrets live in .dev.vars locally and `wrangler secret put` in production.
}
